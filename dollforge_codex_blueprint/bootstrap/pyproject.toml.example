[project]
name = "dollforge"
version = "0.1.0"
requires-python = ">=3.11"
dependencies = [
  "pydantic>=2",
  "pydantic-settings>=2",
  "typer>=0.12",
  "structlog>=24",
]

[project.optional-dependencies]
api = ["fastapi", "uvicorn"]
geometry = ["numpy", "trimesh", "open3d"]
dev = ["pytest", "pytest-cov", "ruff", "mypy"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
line-length = 100
